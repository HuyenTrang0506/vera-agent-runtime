QWEN_API_KEY=

# Recommended default for SafeFlow P0 text/tool reasoning.
QWEN_MODEL=qwen3.7-plus

# Available Qwen quota options from current account.
# Uncomment one if the default quota expires or is unavailable.
# QWEN_MODEL=qwen-plus-2025-07-28
# QWEN_MODEL=qwen3.5-plus-2026-02-15
# QWEN_MODEL=qwen3-max
# QWEN_MODEL=qwen-max
# QWEN_MODEL=qwen3.5-122b-a10b
#
# Not used by P0 text-agent workflow, but available for future OCR/VL features:
# QWEN_MODEL=qwen-vl-ocr-2025-11-20
# QWEN_MODEL=qwen3-vl-235b-a22b-thinking
# QWEN_MODEL=qwen3-vl-30b-a3b-thinking
#
# Not used by P0 unless translation is added:
# QWEN_MODEL=qwen-mt-flash

SAFEFLOW_MODEL_MODE=fixture_fallback
SAFEFLOW_RESULTS_DIR=data/results
SAFEFLOW_FIXTURES_DIR=data/fixtures
SAFEFLOW_BENCHMARK_PATH=data/benchmark/support_demo.jsonl
SAFEFLOW_API_HOST=0.0.0.0
SAFEFLOW_API_PORT=8000
SAFEFLOW_UI_PORT=5173
SAFEFLOW_REFUND_APPROVAL_THRESHOLD=500
SAFEFLOW_MAX_EXTRACTION_REPAIR_ATTEMPTS=1
SAFEFLOW_EVAL_REPEATED_RUNS=5
SAFEFLOW_RANDOM_SEED=42
